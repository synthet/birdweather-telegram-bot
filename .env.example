TELEGRAM_BOT_TOKEN=

# Optional. Public catalog for MCP tools (search_stations, search_species), not used by the Telegram bot.
BIRDWEATHER_API_TOKEN=

# Optional. Station-scoped MCP tools and REST detections (env-only; not passed in tool args).
BIRDWEATHER_STATION_TOKEN=

# Optional. Defaults to ID inferred from BIRDWEATHER_STATION_TOKEN.
BIRDWEATHER_STATION_ID=

BIRDWEATHER_GRAPHQL_ENDPOINT=https://app.birdweather.com/graphql
DATABASE_URL=file:./data/birdweather-bot.sqlite
POLL_INTERVAL_SECONDS=60

# Min minutes between Telegram alerts for the same species at a station (default 30).
SPECIES_NOTIFY_COOLDOWN_MINUTES=30

# Time bucket (minutes) for one acoustic visit; same species + bucket = one alert (default 30).
DETECTION_SESSION_BUCKET_MINUTES=30

# Max station detection count (top 100 species) still treated as rare (default 5).
SPECIES_RARE_STATION_MAX_COUNT=5

# MCP Streamable HTTP (optional). Both must be set to start HTTP MCP with the bot or `npm run mcp:http`.
MCP_AUTH_TOKEN=
MCP_PORT=3001
MCP_HTTP_HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Optional. When unset, eBird commands, taxonomy links, and rarity hints are disabled (https://ebird.org/api/keygen).
EBIRD_API_TOKEN=

# Cursor stdio MCP example (mcpServers.birdweather):
#   command: node, args: ["dist/mcp/stdio.js"], env: { BIRDWEATHER_API_TOKEN, BIRDWEATHER_STATION_TOKEN, ... }
# Cursor HTTP MCP example:
#   url: http://localhost:3001/mcp, headers: { Authorization: "Bearer <MCP_AUTH_TOKEN>" }
