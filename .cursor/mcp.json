{
  "mcpServers": {
    "birdweather": {
      "command": "node",
      "args": ["dist/mcp/stdio.js"],
      "cwd": "${workspaceFolder}"
    },
    "sqlite": {
      "command": "${workspaceFolder}/.cursor/toolbox/toolbox.exe",
      "args": ["--prebuilt", "sqlite", "--stdio"],
      "cwd": "${workspaceFolder}",
      "env": {
        "SQLITE_DATABASE": "./data/birdweather-bot.sqlite"
      }
    }
  }
}
